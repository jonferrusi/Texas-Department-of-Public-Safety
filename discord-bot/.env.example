# Required — get these from the Discord Developer Portal
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here
DISCORD_GUILD_ID=your-server-id-here

# Required for ERLC integration
ERLC_API_KEY=your-erlc-api-key-here

# Optional — used internally by Replit Reserved VM (leave as-is)
PORT=3000
